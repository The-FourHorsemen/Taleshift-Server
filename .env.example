# Supabase (Project Settings → API)
# Use the service_role key on this server only — never ship it to a browser client.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# ASR / storage
TALESHIFT_ASR_MODEL_ID=dsfsi-anv/whisper-large-v3-turbo-anv-zul
TALESHIFT_AUDIO_BUCKET=session-audio

# CORS — comma-separated origins (no spaces required; trimming is applied).
# Include local Next.js and the Vercel production deployment of Taleshift-Client.
ALLOWED_ORIGINS=http://localhost:3000,https://taleshift-client.vercel.app

# Optional: override listen port (Docker / Fly / Railway inject this automatically).
# PORT=8000
